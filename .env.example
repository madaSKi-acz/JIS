# Where the app loads generated map data (tourism.geojson, transport.geojson) from.
# Local dev: files served by Vite from apps/web/public/data.
# Deployed: point this at wherever you upload the data.
VITE_DATA_URL=/data

# Base map style (OpenFreeMap, free, no API key).
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
